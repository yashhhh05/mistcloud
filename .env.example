# ============================================================
# Database Configuration (MongoDB)
# ============================================================
# Provide your MongoDB connection string (e.g. MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mistcloud?retryWrites=true&w=majority

# ============================================================
# Storage Configuration (AWS S3)
# ============================================================
# AWS IAM Credentials for S3 bucket access
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name

# ============================================================
# Authentication & Security
# ============================================================
# Secret key used to sign JWT tokens
JWT_SECRET=super_secret_mist_cloud_jwt_key_2026!

# ============================================================
# Server Configuration
# ============================================================
PORT=3000
NODE_ENV=development
